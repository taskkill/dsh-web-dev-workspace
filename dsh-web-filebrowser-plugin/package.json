{
  "name": "@local/dsh-web-dev-workspace",
  "version": "1.0.4",
  "private": true,
  "description": "VS Code-style development workspace: file explorer, editor, terminal, todo board and preview browser for the DeepSeek Harness Web UI",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "memory.js",
    "todo.js",
    "ssh.js",
    "terminal.js",
    "client.js",
    "vendor/*",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "workspace",
    "file-manager",
    "code-editor",
    "git",
    "todo"
  ],
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "ssh2": "^1.17.0"
  }
}
