{
  "name": "@local/dsh-web-filebrowser-git",
  "version": "1.0.0",
  "private": true,
  "description": "Git status, staging, commit, compare and explicit fetch/pull/push support for the Workspace Files plugin",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "git",
    "source-control",
    "commit"
  ]
}
