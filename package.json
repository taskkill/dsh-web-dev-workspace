{
  "name": "@local/dsh-side",
  "version": "1.1.0",
  "private": true,
  "description": "VS Code-style workspace files, SSH remotes and Git for the DeepSeek Harness Web UI",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./dsh-side-plugin/client.js",
    "./locale/*.json": "./dsh-side-plugin/locale/*.json",
    "./icon": "./dsh-side-plugin/icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "dsh-side-plugin/**",
    "dsh-side-io/**",
    "dsh-side-git/**",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "check": "node --check index.js && node --check dsh-side-plugin/index.js && node --check dsh-side-plugin/ssh.js && node --check dsh-side-plugin/client.js && node --check dsh-side-io/index.js && node --check dsh-side-git/index.js",
    "check:json": "node scripts/check-json.mjs"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "workspace",
    "file-manager",
    "code-editor",
    "git",
    "source-control",
    "ssh"
  ]
}
