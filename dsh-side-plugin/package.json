{
  "name": "@local/dsh-side",
  "version": "1.0.0",
  "private": true,
  "description": "VS Code-style workspace file explorer and editor for the DeepSeek Harness Web UI",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "ssh.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "workspace",
    "file-manager",
    "code-editor",
    "git"
  ],
  "dependencies": {
    "ssh2": "^1.17.0"
  }
}
